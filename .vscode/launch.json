{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ADK: Start Web Playground (.env.local)",
      "type": "debugpy",
      "request": "launch",
      "module": "google.adk.cli",
      "args": [
        "web",
        "--reload_agents"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env.local"
    },
