# Core runtime settings
LINKEDIN_AGENT_ENV=development
LINKEDIN_AGENT_MODEL=gemini-2.0-flash

# Google ADK / Gemini credentials
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_SERVICE_ACCOUNT=agent-runtime@your-gcp-project-id.iam.gserviceaccount.com

# LinkedIn integration placeholders
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
LINKEDIN_API_TEST_URL=https://api.linkedin.com/v2/userinfo
LINKEDIN_API_TIMEOUT_SECONDS=10
LINKEDIN_AGENT_SERVICE_ACCOUNT=agent-runtime@your-gcp-project-id.iam.gserviceaccount.com
LINKEDIN_AGENT_SERVICE_NAME=linkedin-agent
