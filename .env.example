# Core runtime settings
LINKEDIN_AGENT_ENV=development
LINKEDIN_AGENT_MODEL=gemini-3.5-flash

# Google ADK / Gemini credentials
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_SERVICE_ACCOUNT=agent-runtime@your-gcp-project-id.iam.gserviceaccount.com

# LinkedIn integration placeholders for the read-only login service
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
LINKEDIN_AUTH_CODE=authorization-code-from-linkedin
LINKEDIN_API_TEST_URL=https://api.linkedin.com/v2/userinfo
LINKEDIN_API_TIMEOUT_SECONDS=10
LINKEDIN_OAUTH_AUTH_URL=https://www.linkedin.com/oauth/v2/authorization
LINKEDIN_OAUTH_TOKEN_URL=https://www.linkedin.com/oauth/v2/accessToken
LINKEDIN_OAUTH_USERINFO_URL=https://api.linkedin.com/v2/userinfo
LINKEDIN_OAUTH_SCOPES=openid,profile,email
LINKEDIN_OAUTH_CREDENTIAL_KEY=linkedin_oauth
LINKEDIN_OAUTH_CALLBACK_TIMEOUT_SECONDS=180
# Used for encrypted local OAuth credential reuse, including token refresh after expiration.
LINKEDIN_TOKEN_STORAGE_PATH=.secrets/linkedin-token.enc
LINKEDIN_TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
LINKEDIN_AGENT_SERVICE_ACCOUNT=agent-runtime@your-gcp-project-id.iam.gserviceaccount.com
LINKEDIN_AGENT_SERVICE_NAME=linkedin-agent
